VITE_DEMO_MODE="true"
VITE_SPACETIMEDB_URI="http://127.0.0.1:3000"
VITE_SPACETIMEDB_DATABASE="spectre-dw"

# Server-side provider placeholders.
# Load these into SpacetimeDB with the owner-only configure_provider reducer.
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_AGENT_ID="your-elevenlabs-agent-id"
NIMBLE_API_KEY="your-nimble-api-key"
TOWER_WEBHOOK_URL="https://your-tower-orchestration-hook"
RUNPOD_API_KEY="your-runpod-api-key"
RUNPOD_ENDPOINT_ID="your-runpod-endpoint-id"
GEMINI_API_KEY="your-gemini-api-key"
